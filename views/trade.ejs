<!DOCTYPE html>
<html lang="en">
<head>
<title>Trade — <%= team.name %></title>
<%- include('partials/head') %>
<style>
.player-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px;margin-bottom:16px}
.player-option{text-align:left;background:var(--panel2);border:2px solid var(--border);border-radius:10px;padding:10px 12px;color:var(--text);cursor:pointer;transition:all .15s}
.player-option:hover{border-color:var(--c)}
.player-option.selected{border-color:var(--c);background:color-mix(in srgb,var(--c) 14%,var(--panel2))}
.pn{font-size:13px;font-weight:700;margin-bottom:4px}
.pr{font-size:11px;color:var(--dim);display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.pp{font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--money);margin-top:4px}
.field{margin-bottom:12px}
.field label{display:block;font-size:10px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;margin-bottom:6px}
.status{border-radius:12px;padding:14px;font-size:13px}
.st-pending{background:rgba(251,146,60,.1);border:1px solid rgba(251,146,60,.3);color:#fdba74}
.st-approved{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#6ee7b7}
.st-rejected{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5}
.st-none{background:rgba(255,255,255,.03);border:1px solid var(--border);color:var(--dim)}
.status-title{font-family:'Rajdhani',sans-serif;font-size:17px;font-weight:700;letter-spacing:2px;margin:4px 0}
.rules li{font-size:13px;color:var(--dim);margin:8px 0 8px 18px;line-height:1.5}
</style>
</head>
<body style="--c:<%= team.color %>">
<%- include('partials/nav', { active: 'trade' }) %>
<main class="page" style="max-width:760px">
  <section class="panel" style="margin-bottom:14px">
    <div class="label">Trade window</div>
    <div class="h-title" style="margin-bottom:4px">🔄 Player Trading</div>
    <p class="dim small" style="margin-bottom:16px">Nominate one player from your squad. The auctioneer reviews nominations and executes agreed trades.</p>

    <% if (nomination && nomination.status === 'pending') { %>
      <div class="status st-pending">⏳
        <div class="status-title">NOMINATION PENDING</div>
        You offered <b><%= nomination.playerName %></b> · Asking <b><%= nomination.askingPrice || 'Open' %></b>
      </div>
      <button class="btn btn-sm btn-danger" id="cancelBtn" style="margin-top:12px">Cancel nomination</button>
    <% } else if (nomination && nomination.status === 'approved') { %>
      <div class="status st-approved">✅
        <div class="status-title">TRADE COMPLETED</div>
        <b><%= nomination.playerName %></b> was traded<%= nomination.tradedTo ? ' to ' + nomination.tradedTo : '' %>. You can nominate another player below.
      </div>
    <% } else if (nomination && nomination.status === 'rejected') { %>
      <div class="status st-rejected">❌
        <div class="status-title">NOMINATION REJECTED</div>
        <b><%= nomination.playerName %></b> — <%= nomination.reason || 'No reason given' %>
      </div>
    <% } else { %>
      <div class="status st-none">🔄
        <div class="status-title">NO ACTIVE NOMINATION</div>
        You haven't offered any player for trade yet.
      </div>
    <% } %>

    <% if (!nomination || nomination.status !== 'pending') { %>
      <% if (!myPlayers.length) { %>
        <div class="empty">You need players in your squad before you can trade.</div>
      <% } else { %>
        <div class="label" style="margin-top:20px">Select a player to offer</div>
        <div class="player-grid">
          <% myPlayers.forEach(function(p){ %>
          <button type="button" class="player-option" data-name="<%= p.name %>">
            <div class="pn"><%= p.name %></div>
            <div class="pr"><span class="club-badge" style="--cc:<%= clubs[p.club] ? clubs[p.club].color : '#a78bfa' %>"><%= p.club || '—' %></span><%= p.role %></div>
            <div class="pp">Paid <%= fmt(p.soldFor) %></div>
          </button>
          <% }) %>
        </div>
        <div class="field"><label>Selected player</label><input class="input" id="selectedPlayer" placeholder="Tap a player above…" readonly></div>
        <div class="field"><label>Asking price (optional)</label><input class="input" id="askingPrice" placeholder="e.g. ₹2 Cr, or Open"></div>
        <div class="field"><label>Player you'd like in return (optional)</label><input class="input" id="wantedPlayer" placeholder="e.g. Ellyse Perry from 11 Beasts"></div>
        <div class="field"><label>Notes for the auctioneer</label><textarea class="input" id="tradeNotes" placeholder="Any conditions…"></textarea></div>
        <button class="btn btn-team" id="submitBtn" style="width:100%;padding:14px;font-size:16px;letter-spacing:3px" disabled>SUBMIT NOMINATION</button>
      <% } %>
    <% } %>
  </section>

  <section class="panel">
    <div class="label">Trade rules</div>
    <ul class="rules">
      <li>One active nomination per team at a time.</li>
      <li>Teams agree the price; the auctioneer sets the final amount.</li>
      <li>Squad limit (<%= config.maxPlayers %> players) and overseas limit (<%= config.maxOverseas %>) still apply.</li>
      <li>Purses are adjusted by the agreed trade price.</li>
      <li>The auctioneer has the final say on every trade.</li>
    </ul>
  </section>
</main>

<script>
var selected = null
document.querySelectorAll(".player-option").forEach(function(el){
  el.addEventListener("click", function(){
    document.querySelectorAll(".player-option").forEach(function(o){ o.classList.remove("selected") })
    el.classList.add("selected")
    selected = el.dataset.name
    $("selectedPlayer").value = selected
    $("submitBtn").disabled = false
  })
})

if ($("submitBtn")) $("submitBtn").addEventListener("click", async function(){
  if (!selected) return showToast("Pick a player first", "err")
  var btn = this
  btn.disabled = true; btn.textContent = "Submitting…"
  try {
    var r = await fetch("/trade/nominate", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ playerName: selected, askingPrice: $("askingPrice").value, wantedPlayer: $("wantedPlayer").value, notes: $("tradeNotes").value })
    }).then(function(x){ return x.json() })
    if (r.success) location.reload()
    else { showToast(r.error || "Error", "err"); btn.disabled = false; btn.textContent = "SUBMIT NOMINATION" }
  } catch (e) { showToast("Network error", "err"); btn.disabled = false; btn.textContent = "SUBMIT NOMINATION" }
})

if ($("cancelBtn")) $("cancelBtn").addEventListener("click", async function(){
  if (!confirm("Cancel your trade nomination?")) return
  var r = await fetch("/trade/cancel", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).then(function(x){ return x.json() })
  if (r.success) location.reload()
})
</script>
</body>
</html>
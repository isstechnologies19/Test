<!DOCTYPE html>
<html lang="en">
<head>
<title>Leaderboard — <%= config.title %></title>
<%- include('partials/head') %>
<style>
.lb-head,.lb-row{display:grid;grid-template-columns:56px 1fr 70px 100px 90px 70px;gap:8px;align-items:center;padding:12px 16px}
.lb-head span{font-size:9px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;text-align:center}
.lb-head span:nth-child(2){text-align:left}
.lb-row{background:var(--panel);border:1px solid var(--border);border-left:4px solid var(--tc);border-radius:12px;margin-bottom:8px;transition:transform .2s}
.lb-row:hover{transform:translateX(3px)}
.lb-row > div{text-align:center}
.lb-row .team{text-align:left;display:flex;align-items:center;gap:10px;font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700}
.lb-row .dot{width:10px;height:10px;border-radius:50%;background:var(--tc);flex-shrink:0}
.lb-row.top1{background:linear-gradient(90deg,rgba(251,191,36,.10),var(--panel))}
.lb-row.top2{background:linear-gradient(90deg,rgba(212,212,216,.07),var(--panel))}
.lb-row.top3{background:linear-gradient(90deg,rgba(217,119,6,.08),var(--panel))}
.rank{font-family:'Rajdhani',sans-serif;font-size:24px;font-weight:700;color:var(--dim)}
.pts{font-family:'Rajdhani',sans-serif;font-size:24px;font-weight:700;color:var(--money)}
.gap{font-size:13px;font-weight:700;color:#f87171}
@media(max-width:600px){.lb-head,.lb-row{grid-template-columns:40px 1fr 70px 56px}}
</style>
</head>
<body<% if (team) { %> style="--c:<%= team.color %>"<% } %>>
<%- include('partials/nav', { active: 'ranks' }) %>
<main class="page" style="max-width:860px">
  <div style="text-align:center;margin-bottom:24px">
    <div class="h-title grad-text" style="font-size:36px;margin-bottom:4px">🏆 LEADERBOARD</div>
    <div class="dim small" style="letter-spacing:3px"><%= config.title.toUpperCase() %> — FRIENDS EDITION</div>
  </div>
  <div id="content"><div class="empty">Loading…</div></div>
  <div style="text-align:center;margin-top:18px">
    <button class="btn btn-sm" id="refreshBtn">↻ Refresh</button>
    <div class="dim small" id="updInfo" style="margin-top:8px"></div>
  </div>
</main>

<script>
async function load(){
  try {
    var d = await fetch("/api/leaderboard").then(function(r){ return r.json() })
    var html = '<div class="lb-head"><span>#</span><span>Franchise</span><span class="hide-m">Squad</span><span class="hide-m">Purse</span><span>Points</span><span>Gap</span></div>'
    d.teams.forEach(function(t, i){
      var gap = d.hasPoints && t.gap !== 0 ? t.gap.toFixed(1) : "—"
      html += '<div class="lb-row' + (i < 3 ? " top" + (i + 1) : "") + '" style="--tc:' + t.color + '">' +
        '<div class="rank">' + (i < 3 ? ["🥇", "🥈", "🥉"][i] : (i + 1)) + '</div>' +
        '<div class="team"><span class="dot"></span>' + esc(t.name) + '</div>' +
        '<div class="hide-m dim">' + t.playerCount + '</div>' +
        '<div class="hide-m money">' + fmt(t.purse) + '</div>' +
        '<div class="pts">' + (d.hasPoints ? t.points.toFixed(1) : "—") + '</div>' +
        '<div class="gap">' + gap + '</div></div>'
    })
    if (!d.hasPoints) html += '<p class="dim small" style="text-align:center;margin-top:14px">Fantasy points will appear once WBBL|12 matches begin and the points sheet is connected.</p>'
    $("content").innerHTML = html
    $("updInfo").textContent = "Updated " + new Date().toLocaleTimeString()
  } catch (e) {
    $("content").innerHTML = '<div class="empty">Could not load the leaderboard.</div>'
  }
}
$("refreshBtn").addEventListener("click", load)
load()
setInterval(load, 60000)
</script>
</body>
</html>
<!DOCTYPE html>
<html>

<head>

<title>IPL Auction</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<style>

body{
margin:0;
font-family:Inter;
background:linear-gradient(135deg,#020617,#0f172a);
color:white;
height:100vh;
display:flex;
align-items:center;
justify-content:center;
}

.container{
text-align:center;
width:900px;
}

h1{
font-size:42px;
margin-bottom:10px;
}

h2{
font-weight:400;
margin-bottom:40px;
}

.teams{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
}

.team-btn{

background:#2563eb;
border:none;
padding:14px;
border-radius:8px;
font-size:16px;
color:white;
cursor:pointer;
transition:0.2s;

}

.team-btn:hover{

background:#1d4ed8;
transform:scale(1.05);
box-shadow:0 0 15px #2563eb;

}

</style>

</head>

<body>

<div class="container">

<h1>🏏 IPL Auction</h1>
<h2>Select Your Team</h2>

<div class="teams">

<% Object.keys(teams).forEach(function(id){ %>

<a href="/team/<%= id %>">

<button class="team-btn">

<%= teams[id].name %>

</button>

</a>

<% }) %>

</div>

</div>

</body>

</html>

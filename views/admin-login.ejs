<!DOCTYPE html>
<html lang="en">
<head>
<title>Auctioneer Login — <%= config.title %></title>
<%- include('partials/head') %>
<style>
body{display:flex;align-items:center;justify-content:center;padding:20px}
.card{width:100%;max-width:400px;background:var(--panel);border:1px solid var(--border);border-top:3px solid var(--accent);border-radius:14px;padding:46px 34px;text-align:center}
.icon{font-size:50px;display:block;margin-bottom:14px}
h2{font-family:'Rajdhani',sans-serif;font-size:30px;letter-spacing:4px}
.sub{color:var(--dim);font-size:11px;letter-spacing:4px;text-transform:uppercase;margin:4px 0 30px}
.error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#f87171;border-radius:10px;padding:10px;font-size:13px;margin-bottom:14px}
.input{padding:14px;font-size:15px;margin-bottom:14px}
.go{width:100%;padding:15px;font-size:17px;letter-spacing:4px}
.back{display:block;margin-top:18px;color:var(--dim);font-size:12px;text-decoration:none}
</style>
</head>
<body>
<div class="card">
  <span class="icon">🎙️</span>
  <h2>AUCTIONEER</h2>
  <p class="sub">Control panel access</p>
  <% if (error) { %><div class="error">⚠ <%= error %></div><% } %>
  <form method="POST" action="/admin/login">
    <input class="input" type="password" name="password" placeholder="Admin password" autofocus required>
    <button class="btn btn-primary go" type="submit">ENTER PANEL →</button>
  </form>
  <a class="back" href="/">← Back to home</a>
</div>
</body>
</html>